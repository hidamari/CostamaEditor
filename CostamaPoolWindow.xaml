<Window x:Class="CostamaEditor.CostamaPoolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Ui.Pool.Title}" Width="1220" Height="820" MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBackground}" Foreground="#E7EEF7">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="166" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Center">
            <DockPanel>
                <TextBlock Text="{DynamicResource Ui.Pool.Title}" FontSize="21" FontWeight="Bold" />
                <TextBlock Text="{Binding MainItemSummary}" Foreground="{StaticResource AccentBrush}" FontSize="15" Margin="14,4,0,0" />
            </DockPanel>
            <TextBlock Text="{DynamicResource Ui.Pool.Intro}" Foreground="{StaticResource MutedText}" FontSize="14" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /><RowDefinition Height="40" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Ui.Pool.Candidates.Title}" FontSize="16" FontWeight="Bold" />
                            <TextBlock Text="{DynamicResource Ui.Pool.Candidates.Hint}" Foreground="{StaticResource MutedText}" FontSize="13" Margin="0,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBox Grid.Column="1" x:Name="CandidateSearchBox" Width="180" VerticalContentAlignment="Center" ToolTip="{DynamicResource Ui.Pool.Candidates.SearchTooltip}" TextChanged="CandidateSearch_TextChanged" />
                    </Grid>

                    <DataGrid Grid.Row="1" x:Name="CandidateGrid" ItemsSource="{Binding CandidatesView}" SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}"
                              SelectionMode="Extended" SelectionUnit="FullRow" AlternationCount="2" Margin="0,9,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Ui.Grid.Id}" Binding="{Binding Id}" Width="74" />
                            <DataGridTextColumn Header="{DynamicResource Ui.Grid.Name}" Binding="{Binding JapaneseName}" Width="*" />
                            <DataGridTextColumn Header="{DynamicResource Ui.Grid.Category}" Binding="{Binding Category}" Width="78" />
                            <DataGridTextColumn Header="{DynamicResource Ui.Grid.Type}" Binding="{Binding Type}" Width="62" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <DockPanel Grid.Row="2">
                        <TextBlock Text="{Binding CandidateCountText}" Foreground="{StaticResource MutedText}" FontSize="13" VerticalAlignment="Center" />
                        <Button Content="{DynamicResource Ui.Pool.Candidates.Add}" DockPanel.Dock="Right" Click="AddReward_Click" Margin="0" />
                    </DockPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="68" /><RowDefinition Height="*" /><RowDefinition Height="36" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Ui.Pool.Rewards.Title}" FontSize="16" FontWeight="Bold" />
                            <TextBlock Text="{DynamicResource Ui.Pool.Rewards.Hint}" Foreground="{StaticResource MutedText}" FontSize="13" Margin="0,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="{DynamicResource Ui.Pool.Target}" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <ComboBox x:Name="TargetComboBox" Width="260" ItemsSource="{Binding TargetChoices}" SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                                          SelectionChanged="Target_SelectionChanged" Padding="7,5" Background="#F1F5F9" Foreground="#17304A" BorderBrush="#718096"
                                          TextElement.Foreground="#17304A" ItemContainerStyle="{StaticResource ReadableComboBoxItemStyle}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Path}" Foreground="#17304A" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,3,0,0">
                                <TextBlock Text="{DynamicResource Ui.Pool.MaxValue}" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Text="{Binding MaxValueText, UpdateSourceTrigger=PropertyChanged}" Width="90" HorizontalContentAlignment="Right"
                                         VerticalContentAlignment="Center" Padding="5,2" Background="#17283D" BorderBrush="#6A8DAD"
                                         Foreground="#E7EEF7" CaretBrush="#E7EEF7" ToolTip="{DynamicResource Ui.Pool.MaxValue.Tooltip}" />
                                <TextBlock Text="{Binding TotalWeightText}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="14,0,0,0" FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1" x:Name="RewardGrid" ItemsSource="{Binding Rewards}" SelectedItem="{Binding SelectedReward, Mode=TwoWay}"
                              SelectionMode="Extended" SelectionUnit="FullRow" AlternationCount="2" Margin="0,5,0,7" PreviewKeyDown="RewardGrid_PreviewKeyDown">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{DynamicResource Ui.Pool.Icon}" Width="58" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><Image Source="{Binding Icon}" Width="32" Height="32" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True" ToolTip="{Binding IconStatus}" /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{DynamicResource Ui.Grid.Id}" Binding="{Binding Item.Id}" Width="70" IsReadOnly="True" />
                            <DataGridTextColumn Header="{DynamicResource Ui.Pool.Prize}" Binding="{Binding Item.JapaneseName}" Width="*" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="{DynamicResource Ui.Pool.Weight}" Width="92" IsReadOnly="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding WeightText, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Right"
                                                 VerticalContentAlignment="Center" Padding="5,2" Margin="3,2" Background="#17283D" BorderBrush="#6A8DAD"
                                                 Foreground="#E7EEF7" CaretBrush="#E7EEF7" ToolTip="{DynamicResource Ui.Pool.Weight.Tooltip}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{DynamicResource Ui.Pool.Quantity}" Width="82" IsReadOnly="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Right"
                                                 VerticalContentAlignment="Center" Padding="5,2" Margin="3,2" Background="#17283D" BorderBrush="#6A8DAD"
                                                 Foreground="#E7EEF7" CaretBrush="#E7EEF7" ToolTip="{DynamicResource Ui.Pool.Quantity.Tooltip}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <DockPanel Grid.Row="2">
                        <TextBlock Text="{Binding ValidationText}" Foreground="{Binding ValidationBrush}" FontSize="14" VerticalAlignment="Center" />
                        <Button Content="{DynamicResource Ui.Pool.Remove}" DockPanel.Dock="Right" Click="RemoveReward_Click" Margin="0" Padding="9,4" />
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="24" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock Text="{DynamicResource Ui.Pool.Script.Title}" FontSize="15" FontWeight="Bold" Foreground="#B8C9DC" />
                    <TextBlock Text="{DynamicResource Ui.Pool.Script.Hint}" Foreground="{StaticResource MutedText}" FontSize="13" Margin="10,2,0,0" />
                </DockPanel>
                <TextBox Grid.Row="1" Text="{Binding ScriptPreview, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="14" Padding="8" />
            </Grid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedText}" FontSize="14" VerticalAlignment="Center" />
            <Button Content="{DynamicResource Ui.Pool.Apply}" DockPanel.Dock="Right" Click="Apply_Click" Margin="8,0,0,0" IsEnabled="{Binding CanApply}" Background="#19463F" BorderBrush="#287767" />
            <Button Content="{DynamicResource Ui.Pool.Close}" DockPanel.Dock="Right" Click="Close_Click" Margin="8,0,0,0" />
        </DockPanel>
    </Grid>
</Window>
