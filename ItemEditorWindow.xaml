<Window x:Class="CostamaEditor.ItemEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Width="1020" Height="900" MinWidth="850" MinHeight="720"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource AppBackground}" Foreground="#E7EEF7">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="176" />
            <RowDefinition Height="54" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Center">
            <TextBlock Text="{Binding WindowTitle}" FontSize="21" FontWeight="Bold" />
            <TextBlock Text="{DynamicResource Ui.Editor.Subtitle}" Foreground="{StaticResource MutedText}" FontSize="14" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Ui.Editor.Target}" Foreground="#B8C9DC" VerticalAlignment="Center" />
                <ComboBox x:Name="TargetComboBox" Grid.Column="1" ItemsSource="{Binding TargetChoices}" SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                          SelectionChanged="Target_SelectionChanged" Padding="8,5" Background="#F1F5F9" Foreground="#17304A" BorderBrush="#718096"
                          TextElement.Foreground="#17304A" ItemContainerStyle="{StaticResource ReadableComboBoxItemStyle}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Path}" Foreground="#17304A" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="{DynamicResource Ui.Editor.Fields}" FontSize="15" FontWeight="Bold" Foreground="#B8C9DC" Margin="2,2,0,7" />
                <ItemsControl ItemsSource="{Binding Fields}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="7" Padding="9" Margin="0,0,8,8">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="132" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" FontSize="14" />
                                    <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"
                                             VerticalContentAlignment="Center" Padding="7,5" TextChanged="EditorValue_TextChanged" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{DynamicResource Ui.Editor.Scripts}" FontSize="15" FontWeight="Bold" Foreground="#B8C9DC" Margin="2,6,0,7" />
                <ItemsControl ItemsSource="{Binding Scripts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="7" Padding="9" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="132" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedText}" VerticalAlignment="Top" Margin="0,5,0,0" FontSize="14" />
                                    <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="False" TextWrapping="NoWrap"
                                             HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Center" Padding="7,6" Height="44" FontFamily="Consolas"
                                             TextChanged="EditorValue_TextChanged" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="10">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="22" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock Text="{DynamicResource Ui.Editor.Preview}" FontSize="15" FontWeight="Bold" Foreground="#B8C9DC" />
                    <TextBlock Text="{Binding PreviewStatus}" Foreground="{StaticResource MutedText}" FontSize="13" Margin="10,2,0,0" />
                </DockPanel>
                <TextBox Grid.Row="1" Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13" Padding="8" />
            </Grid>
        </Border>

        <DockPanel Grid.Row="4" LastChildFill="True" Margin="0,10,0,0">
            <Button Content="{DynamicResource Ui.Editor.Cancel}" DockPanel.Dock="Right" Click="Cancel_Click" Margin="8,0,0,0" />
            <Button x:Name="SaveButton" Content="{DynamicResource Ui.Editor.Save}" DockPanel.Dock="Right" Click="Save_Click" Margin="8,0,0,0" IsEnabled="False" Background="#19463F" BorderBrush="#287767" />
            <Button Content="{DynamicResource Ui.Editor.GeneratePreview}" DockPanel.Dock="Right" Click="Preview_Click" Margin="8,0,0,0" />
            <CheckBox x:Name="ConflictCheckBox" Content="{DynamicResource Ui.Editor.ConflictCheck}" Foreground="#E8C77D" VerticalAlignment="Center"
                      Visibility="Collapsed" Checked="ConflictCheckBox_Changed" Unchecked="ConflictCheckBox_Changed" />
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</Window>
