<Window x:Class="CostamaEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Costama Editor Ver 0.1.0" Width="1440" Height="900" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackground}"
        Foreground="#E7EEF7">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Border Width="4" Height="30" Background="{StaticResource AccentBrush}" CornerRadius="2" Margin="0,0,12,0" />
                    <TextBlock Text="COSTAMA EDITOR" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{DynamicResource Ui.Main.Subtitle}" Foreground="{StaticResource MutedText}" FontSize="15" Margin="16,5,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="{DynamicResource Ui.Language.Label}" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="LanguageComboBox" Width="140" SelectedValuePath="Tag" SelectionChanged="Language_SelectionChanged"
                          Foreground="#17304A" Background="#F1F5F9" BorderBrush="#718096" TextElement.Foreground="#17304A"
                          ItemContainerStyle="{StaticResource ReadableComboBoxItemStyle}">
                    <ComboBoxItem Tag="zh-Hant" Style="{StaticResource ReadableComboBoxItemStyle}"><TextBlock Text="繁體中文" Foreground="#17304A" /></ComboBoxItem>
                    <ComboBoxItem Tag="en" Style="{StaticResource ReadableComboBoxItemStyle}"><TextBlock Text="English" Foreground="#17304A" /></ComboBoxItem>
                    <ComboBoxItem Tag="ja" Style="{StaticResource ReadableComboBoxItemStyle}"><TextBlock Text="日本語" Foreground="#17304A" /></ComboBoxItem>
                </ComboBox>
            </StackPanel>
            <Button Grid.Column="2" Content="{DynamicResource Ui.Main.Reload}" Padding="16,9" Margin="0" Background="#19463F" BorderBrush="#287767"
                    Click="Reload_Click" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,9">
                                <TextBlock Text="{DynamicResource Ui.Main.Db.Title}" FontWeight="Bold" FontSize="15" Foreground="#B8C9DC" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Ui.Main.Db.Priority}" Foreground="{StaticResource MutedText}" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <ListBox x:Name="ItemDbList" ItemsSource="{Binding ItemDbSources}" Height="142" BorderThickness="0" Background="#0C1727" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate><DataTemplate>
                                    <Border Padding="7,5" BorderBrush="#17263A" BorderThickness="0,0,0,1" ToolTip="{Binding Detail}">
                                        <StackPanel>
                                            <DockPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="13" DockPanel.Dock="Right" /></DockPanel>
                                            <TextBlock Text="{Binding Path}" Foreground="{StaticResource MutedText}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                <Button Content="{DynamicResource Ui.Source.Add}" Tag="ItemDb" Click="AddSource_Click" />
                                <Button Content="{DynamicResource Ui.Source.Remove}" Tag="ItemDb" Click="RemoveSource_Click" />
                                <Button Content="↑" Tag="ItemDb" Click="MoveSourceUp_Click" Padding="8,6" ToolTip="{DynamicResource Ui.Source.MoveUp}" />
                                <Button Content="↓" Tag="ItemDb" Click="MoveSourceDown_Click" Padding="8,6" ToolTip="{DynamicResource Ui.Source.MoveDown}" Margin="0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,9">
                                <TextBlock Text="{DynamicResource Ui.Main.ItemInfo.Title}" FontWeight="Bold" FontSize="15" Foreground="#B8C9DC" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Ui.Main.Source.Priority}" Foreground="{StaticResource MutedText}" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <ListBox x:Name="ItemInfoList" ItemsSource="{Binding ItemInfoSources}" Height="142" BorderThickness="0" Background="#0C1727" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate><DataTemplate>
                                    <Border Padding="7,5" BorderBrush="#17263A" BorderThickness="0,0,0,1" ToolTip="{Binding Detail}">
                                        <StackPanel>
                                            <DockPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="13" DockPanel.Dock="Right" /></DockPanel>
                                            <TextBlock Text="{Binding Path}" Foreground="{StaticResource MutedText}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                <Button Content="{DynamicResource Ui.Source.Add}" Tag="ItemInfo" Click="AddSource_Click" />
                                <Button Content="{DynamicResource Ui.Source.Remove}" Tag="ItemInfo" Click="RemoveSource_Click" />
                                <Button Content="↑" Tag="ItemInfo" Click="MoveSourceUp_Click" Padding="8,6" ToolTip="{DynamicResource Ui.Source.MoveUp}" />
                                <Button Content="↓" Tag="ItemInfo" Click="MoveSourceDown_Click" Padding="8,6" ToolTip="{DynamicResource Ui.Source.MoveDown}" Margin="0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="14">
                        <StackPanel>
                            <Grid Margin="0,0,0,9">
                                <TextBlock Text="{DynamicResource Ui.Main.Grf.Title}" FontWeight="Bold" FontSize="15" Foreground="#B8C9DC" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Ui.Main.Source.Priority}" Foreground="{StaticResource MutedText}" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <ListBox x:Name="GrfList" ItemsSource="{Binding GrfSources}" Height="142" BorderThickness="0" Background="#0C1727" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate><DataTemplate>
                                    <Border Padding="7,5" BorderBrush="#17263A" BorderThickness="0,0,0,1" ToolTip="{Binding Detail}">
                                        <StackPanel>
                                            <DockPanel><TextBlock Text="{Binding Name}" Foreground="#E7EEF7" FontWeight="SemiBold" /><TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="13" DockPanel.Dock="Right" /></DockPanel>
                                            <TextBlock Text="{Binding Path}" Foreground="{StaticResource MutedText}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                <Button Content="{DynamicResource Ui.Source.Add}" Tag="Grf" Click="AddSource_Click" />
                                <Button Content="{DynamicResource Ui.Source.Remove}" Tag="Grf" Click="RemoveSource_Click" />
                                <Button Content="↑" Tag="Grf" Click="MoveSourceUp_Click" Padding="8,6" ToolTip="{DynamicResource Ui.Source.MoveUp}" />
                                <Button Content="↓" Tag="Grf" Click="MoveSourceDown_Click" Padding="8,6" ToolTip="{DynamicResource Ui.Source.MoveDown}" Margin="0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="74" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="180" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Ui.Main.Catalog.Title}" FontWeight="Bold" FontSize="17" />
                            <TextBlock Text="{DynamicResource Ui.Main.Catalog.Subtitle}" Foreground="{StaticResource MutedText}" FontSize="14" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBox Grid.Column="1" x:Name="SearchBox" Width="250" VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,8,0"
                                 ToolTip="{DynamicResource Ui.Main.Search.Tooltip}" TextChanged="SearchBox_TextChanged" />
                        <Button Grid.Column="2" Content="{DynamicResource Ui.Main.NewItem}" Click="NewItem_Click" Margin="0,0,8,0" />
                        <Button Grid.Column="3" x:Name="EditItemButton" Content="{DynamicResource Ui.Main.EditItem}" Click="EditItem_Click" Margin="0,0,8,0" IsEnabled="False" />
                        <Button Grid.Column="4" x:Name="CostamaButton" Content="{DynamicResource Ui.Main.Costama}" Click="CostamaPool_Click" Margin="0" IsEnabled="False" />
                    </Grid>
                </Border>

                <DataGrid Grid.Row="1" x:Name="ItemsGrid" ItemsSource="{Binding ItemsView}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          SelectionChanged="ItemGrid_SelectionChanged" AlternationCount="2" Margin="0,0,0,12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Ui.Grid.Id}" Binding="{Binding Id}" Width="84" />
                        <DataGridTextColumn Header="{DynamicResource Ui.Grid.Name}" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="{DynamicResource Ui.Grid.Category}" Binding="{Binding Category}" Width="90" />
                        <DataGridTextColumn Header="{DynamicResource Ui.Grid.JapaneseName}" Binding="{Binding JapaneseName}" Width="2*" />
                        <DataGridTextColumn Header="{DynamicResource Ui.Grid.Type}" Binding="{Binding Type}" Width="74" />
                        <DataGridTextColumn Header="{DynamicResource Ui.Grid.DefinitionSource}" Binding="{Binding DefinitionSource}" Width="3*" />
                        <DataGridTextColumn Header="{DynamicResource Ui.Grid.ResourceName}" Binding="{Binding ResourceName}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="2" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="104" Height="104" Background="#0C1727" BorderBrush="#26364B" BorderThickness="1" CornerRadius="8" VerticalAlignment="Center">
                            <Grid>
                                <Image Source="{Binding PreviewImage}" Width="72" Height="72" Stretch="Uniform"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True" />
                                <TextBlock x:Name="IconPlaceholder" Text="{DynamicResource Ui.Main.IconPlaceholder}" Foreground="#53647A" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <DockPanel>
                                <TextBlock Text="{Binding SelectedItem.Name}" FontSize="20" FontWeight="Bold" />
                                <TextBlock Text="{DynamicResource Ui.Main.IdLabel}" Foreground="{StaticResource MutedText}" FontFamily="Consolas" FontSize="15" Margin="12,4,3,0" />
                                <TextBlock Text="{Binding SelectedItem.Id}" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" FontSize="15" Margin="0,4,0,0" />
                            </DockPanel>
                            <TextBlock Text="{Binding SelectedItem.JapaneseName}" Foreground="{StaticResource MutedText}" FontSize="15" Margin="0,4,0,7" />
                            <WrapPanel>
                                <TextBlock Text="{DynamicResource Ui.Main.CategoryLabel}" Foreground="{StaticResource MutedText}" /><TextBlock Text="{Binding SelectedItem.Category}" Margin="0,0,18,0" />
                                <TextBlock Text="{DynamicResource Ui.Main.TypeLabel}" Foreground="{StaticResource MutedText}" /><TextBlock Text="{Binding SelectedItem.Type}" Margin="0,0,18,0" />
                                <TextBlock Text="{DynamicResource Ui.Main.ResourceLabel}" Foreground="{StaticResource MutedText}" /><TextBlock Text="{Binding SelectedItem.ResourceName}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding PreviewMessage}" Foreground="{StaticResource MutedText}" FontSize="14" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SelectedItem.DefinitionSource}" Foreground="{StaticResource MutedText}" FontSize="13" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{DynamicResource Ui.Main.SourceTooltip}" />
                            <TextBlock Text="{Binding SelectedItemHistoryText}" Foreground="#73869C" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{DynamicResource Ui.Main.HistoryTooltip}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <DockPanel Grid.Row="4">
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedText}" FontSize="14" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ResultCountText}" Foreground="{StaticResource AccentBrush}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </DockPanel>
    </Grid>
</Window>
